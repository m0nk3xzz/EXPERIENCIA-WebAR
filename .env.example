# ============================================================
# Plantilla de variables de entorno
# ============================================================
# Copiar a `.env` para desarrollo local:
#   cp .env.example .env
#
# IMPORTANTE: en producción (Vercel) estas variables se configuran en el
# panel del proyecto, NO en este archivo. `.env` lo lee `vercel dev` y
# Vite en local; el runtime serverless NO lo carga.

# API key de Google AI Studio (https://aistudio.google.com/apikey).
# La lee únicamente el backend (api/token.js): el navegador nunca la ve.
# Sin esta variable, /api/token responde 500.
GEMINI_API_KEY=

# Dominios autorizados a pedir tokens, separados por coma y SIEMPRE con
# esquema (https://...). El dominio de producción de Vercel se permite
# solo. Ej:
#   ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,https://tudominio.com
ALLOWED_ORIGINS=

# Modelo de Gemini Live. Vacío = el valor por defecto de api/token.js.
# Sirve para migrar de modelo sin tocar código (los modelos "preview" se
# retiran con el tiempo). El cambio se aplica al redesplegar.
GEMINI_LIVE_MODEL=
